kafka_topics = {
  orders_v1 = {
    name                = "orders.v1"
    cluster_key         = "orders"
    partitions          = 6
    replication_factor  = 3
    min_insync_replicas = 2
  }

  payments_v1 = {
    name                = "payments.v1"
    cluster_key         = "orders"
    partitions          = 6
    replication_factor  = 3
    min_insync_replicas = 2
  }
}

topic_producers = {
  orders_producer = {
    name        = "orders-v1-producer"
    cluster_key = "orders"
    topic_keys  = ["orders_v1"]
  }

  payments_producer = {
    name        = "payments-v1-producer"
    cluster_key = "orders"
    topic_keys  = ["payments_v1"]
  }
}
